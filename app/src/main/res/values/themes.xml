<resources>
    <style name="Base.Theme.StockFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/elegant_primary</item>
        <item name="colorOnPrimary">@color/elegant_on_primary</item>
        <item name="colorPrimaryContainer">@color/elegant_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/elegant_on_primary_container</item>
        <item name="colorSecondary">@color/elegant_secondary</item>
        <item name="colorOnSecondary">@color/elegant_on_secondary</item>
        <item name="android:colorBackground">@color/elegant_background</item>
        <item name="colorOnBackground">@color/elegant_on_background</item>
        <item name="colorSurface">@color/elegant_surface</item>
        <item name="colorOnSurface">@color/elegant_on_surface</item>
        <item name="colorOutline">@color/elegant_outline</item>
        <item name="android:statusBarColor">@color/elegant_primary</item>
        <item name="android:navigationBarColor">@color/elegant_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialButtonStyle">@style/Widget.StockFlow.Button</item>
        <item name="textInputStyle">@style/Widget.StockFlow.TextInputLayout</item>
    </style>

    <style name="Theme.StockFlow" parent="Base.Theme.StockFlow" />

    <style name="Widget.StockFlow.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorSurface</item>
        <item name="android:elevation">0dp</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="subtitleTextColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.StockFlow.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">18dp</item>
    </style>

    <style name="Widget.StockFlow.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
        <item name="boxStrokeColor">?attr/colorPrimary</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>

    <style name="CircularImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>